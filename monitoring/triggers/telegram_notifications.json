{
  "stellar_p1_telegram": {
    "name": "P1 Critical - Telegram",
    "trigger_type": "telegram",
    "config": {
      "token": {
        "type": "environment",
        "value": "TELEGRAM_BOT_TOKEN"
      },
      "chat_id": {
        "type": "environment",
        "value": "TELEGRAM_CHAT_ID"
      },
      "message": {
        "title": "[P1 CRITICAL] ${monitor.name}",
        "body": "Tx: ${transaction.hash} — investigate immediately."
      }
    }
  },
  "stellar_p2_telegram": {
    "name": "P2 Elevated - Telegram",
    "trigger_type": "telegram",
    "config": {
      "token": {
        "type": "environment",
        "value": "TELEGRAM_BOT_TOKEN"
      },
      "chat_id": {
        "type": "environment",
        "value": "TELEGRAM_CHAT_ID"
      },
      "message": {
        "title": "[P2] ${monitor.name}",
        "body": "Tx: ${transaction.hash} — verify against governance records."
      }
    }
  },
  "stellar_p3_telegram": {
    "name": "P3 Info - Telegram",
    "trigger_type": "telegram",
    "config": {
      "token": {
        "type": "environment",
        "value": "TELEGRAM_BOT_TOKEN"
      },
      "chat_id": {
        "type": "environment",
        "value": "TELEGRAM_CHAT_ID"
      },
      "message": {
        "title": "[P3] ${monitor.name}",
        "body": "Tx: ${transaction.hash}"
      }
    }
  }
}
